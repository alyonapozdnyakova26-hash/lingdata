        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a703"
                TIME_SLOT_REF1="ts2106" TIME_SLOT_REF2="ts2114">
                <ANNOTATION_VALUE>вот по ним готовились</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a704"
                TIME_SLOT_REF1="ts2116" TIME_SLOT_REF2="ts2134">
                <ANNOTATION_VALUE>а и вот ну на задачу</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a705"
                TIME_SLOT_REF1="ts2136" TIME_SLOT_REF2="ts2150">
