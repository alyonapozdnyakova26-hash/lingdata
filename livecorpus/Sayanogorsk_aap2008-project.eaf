            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a715"
                TIME_SLOT_REF1="ts2235" TIME_SLOT_REF2="ts2247">
