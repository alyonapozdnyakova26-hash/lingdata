            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a706"
                TIME_SLOT_REF1="ts2152" TIME_SLOT_REF2="ts2156">
                <ANNOTATION_VALUE>на черновик</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a707"
                TIME_SLOT_REF1="ts2158" TIME_SLOT_REF2="ts2164">
