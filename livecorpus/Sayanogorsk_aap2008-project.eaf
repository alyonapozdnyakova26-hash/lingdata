            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a709"
                TIME_SLOT_REF1="ts2176" TIME_SLOT_REF2="ts2187">
                <ANNOTATION_VALUE>вот ии ну</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a710"
                TIME_SLOT_REF1="ts2189" TIME_SLOT_REF2="ts2199">
                <ANNOTATION_VALUE>а лингвистические задачи мне кажется</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a711"
                TIME_SLOT_REF1="ts2201" TIME_SLOT_REF2="ts2207">
                <ANNOTATION_VALUE>это ещё сложнее</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a712"
                TIME_SLOT_REF1="ts2209" TIME_SLOT_REF2="ts2219">
                <ANNOTATION_VALUE>поэтому вообще как=</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a713"
                TIME_SLOT_REF1="ts2221" TIME_SLOT_REF2="ts2225">
                <ANNOTATION_VALUE>как концепт</ANNOTATION_VALUE>
