        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a663"
                TIME_SLOT_REF1="ts1538" TIME_SLOT_REF2="ts1544">
                <ANNOTATION_VALUE>два тура получается</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a664"
                TIME_SLOT_REF1="ts1546" TIME_SLOT_REF2="ts1560">
                <ANNOTATION_VALUE>э и перед первым</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a665"
                TIME_SLOT_REF1="ts1565" TIME_SLOT_REF2="ts1582">
                <ANNOTATION_VALUE>у нас всю ночь была атака БПЛА</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a666"
                TIME_SLOT_REF1="ts1585" TIME_SLOT_REF2="ts1598">
                <ANNOTATION_VALUE>э это была такая</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a667"
                TIME_SLOT_REF1="ts1600" TIME_SLOT_REF2="ts1617">
                <ANNOTATION_VALUE>ну они вообще эти атаки</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a668"
                TIME_SLOT_REF1="ts1619" TIME_SLOT_REF2="ts1627">
                <ANNOTATION_VALUE>сначала были такие коротенькие</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a669"
                TIME_SLOT_REF1="ts1629" TIME_SLOT_REF2="ts1646">
                <ANNOTATION_VALUE>там / по тридцать минут</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a670"
                TIME_SLOT_REF1="ts1648" TIME_SLOT_REF2="ts1654">
                <ANNOTATION_VALUE>потом удлинялись удлинялись</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a671"
                TIME_SLOT_REF1="ts1656" TIME_SLOT_REF2="ts1682">
                <ANNOTATION_VALUE>и эта была вот одна из таких первых очень длинных</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a672"
                TIME_SLOT_REF1="ts1684" TIME_SLOT_REF2="ts1692">
                <ANNOTATION_VALUE>там я не знаю</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a673"
                TIME_SLOT_REF1="ts1694" TIME_SLOT_REF2="ts1698">
                <ANNOTATION_VALUE>часов восемь</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a674"
                TIME_SLOT_REF1="ts1700" TIME_SLOT_REF2="ts1716">
                <ANNOTATION_VALUE>и у нас обязательная эвакуация</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a675"
                TIME_SLOT_REF1="ts1718" TIME_SLOT_REF2="ts1726">
                <ANNOTATION_VALUE>мы сидели в подвале</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a676"
                TIME_SLOT_REF1="ts1728" TIME_SLOT_REF2="ts1738">
                <ANNOTATION_VALUE>и я вообще не спала</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a677"
                TIME_SLOT_REF1="ts1740" TIME_SLOT_REF2="ts1752">
                <ANNOTATION_VALUE>и в итоге слила первый тур</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a678"
                TIME_SLOT_REF1="ts1760" TIME_SLOT_REF2="ts1776">
                <ANNOTATION_VALUE>у меня вот / близко к нулю короче</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a679"
                TIME_SLOT_REF1="ts1784" TIME_SLOT_REF2="ts1794">
                <ANNOTATION_VALUE>а воторой я хорошо написала</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a680"
                TIME_SLOT_REF1="ts1796" TIME_SLOT_REF2="ts1810">
                <ANNOTATION_VALUE>но в сумме мне не хватило конечно</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a681"
                TIME_SLOT_REF1="ts1815" TIME_SLOT_REF2="ts1817">
                <ANNOTATION_VALUE>вот</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a682"
                TIME_SLOT_REF1="ts1819" TIME_SLOT_REF2="ts1833">
                <ANNOTATION_VALUE>это такое разочарование школьной жизни</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a685"
                TIME_SLOT_REF1="ts1871" TIME_SLOT_REF2="ts1875">
                <ANNOTATION_VALUE>ну да</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a692"
                TIME_SLOT_REF1="ts1947" TIME_SLOT_REF2="ts1949">
                <ANNOTATION_VALUE>ну</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a693"
                TIME_SLOT_REF1="ts1951" TIME_SLOT_REF2="ts1959">
                <ANNOTATION_VALUE>я об этом думала</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a694"
                TIME_SLOT_REF1="ts1961" TIME_SLOT_REF2="ts1976">
                <ANNOTATION_VALUE>мне кажется просто</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a695"
                TIME_SLOT_REF1="ts1978" TIME_SLOT_REF2="ts1996">
                <ANNOTATION_VALUE>что сейчас мне не хватит времени и сил</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a696"
                TIME_SLOT_REF1="ts1998" TIME_SLOT_REF2="ts2010">
                <ANNOTATION_VALUE>потому что вот</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a697"
                TIME_SLOT_REF1="ts2012" TIME_SLOT_REF2="ts2023">
                <ANNOTATION_VALUE>ну я в десятом классе</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a698"
                TIME_SLOT_REF1="ts2025" TIME_SLOT_REF2="ts2040">
                <ANNOTATION_VALUE>готовилась к русскому</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a699"
                TIME_SLOT_REF1="ts2042" TIME_SLOT_REF2="ts2059">
                <ANNOTATION_VALUE>у Кирилла и Мефодия</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a700"
                TIME_SLOT_REF1="ts2061" TIME_SLOT_REF2="ts2069">
                <ANNOTATION_VALUE>там был такой формат </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a701"
                TIME_SLOT_REF1="ts2071" TIME_SLOT_REF2="ts2086">
                <ANNOTATION_VALUE>что мы составляли задачи</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a702"
                TIME_SLOT_REF1="ts2088" TIME_SLOT_REF2="ts2104">
                <ANNOTATION_VALUE>как будто бы для олимпиады по русскому сами</ANNOTATION_VALUE>
